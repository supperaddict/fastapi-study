# 复制为 .env；随机生成密钥：python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg://fastapi:local_dev_password@127.0.0.1:5432/fastapi_study
TEST_DATABASE_URL=postgresql+psycopg://fastapi:local_dev_password@127.0.0.1:5432/fastapi_test
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=fastapi_study
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
TOKEN_MINUTES=30
CACHE_TTL=60
LOG_LEVEL=INFO
ENABLE_DEMO_ROUTES=false
DOMAIN=localhost
